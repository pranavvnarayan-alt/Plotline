# ==========================================
# AI Provider Configuration (Choose Option A or B)
# ==========================================

# Option A: OpenRouter (Recommended if deploying to Vercel with an OpenRouter key)
# Get your key at: https://openrouter.ai/keys
# The adapter also automatically detects if GEMINI_API_KEY starts with "sk-or-"!
OPENROUTER_API_KEY="sk-or-v1-..."
# Optional model choice (defaults to google/gemini-2.5-flash):
OPENROUTER_MODEL="google/gemini-2.5-flash"

# Option B: Native Google AI Studio Gemini API Key
# Get your key at: https://aistudio.google.com/app/apikey
# AI Studio automatically injects this in the container environment.
GEMINI_API_KEY="AIzaSy..."

# ==========================================
# Optional Integrations
# ==========================================

# TMDB_API_KEY: Optional API key for The Movie Database (TMDB).
# Enables live poster imagery, genres, runtimes, and catalog discovery for films after January 2025.
# Get free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# APIFY_API_TOKEN: Optional API token for Apify Google Lens Scraper actor.
# Enables automated background reverse image searching on uploaded movie scenes/posters.
# Get token at: https://console.apify.com/account/integrations
APIFY_API_TOKEN=""

# APP_URL: The URL where this app is hosted (e.g., https://your-project.vercel.app).
APP_URL=""
